{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare Queues Consumer Queue API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Queue",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Queues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the queues owned by an account."
        },
        {
          "info": {
            "name": "Create Queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new queue"
        },
        {
          "info": {
            "name": "Get Queue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get details about a specific queue."
        },
        {
          "info": {
            "name": "Update Queue",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a Queue. Note that this endpoint does not support partial updates. If successful, the Queue's configuration is overwritten with the supplied configuration."
        },
        {
          "info": {
            "name": "Update Queue (Partial)",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a Queue (partial update)."
        },
        {
          "info": {
            "name": "Delete Queue",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a queue"
        },
        {
          "info": {
            "name": "Get Queue Purge Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id/purge",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get details about a Queue's purge status."
        },
        {
          "info": {
            "name": "Purge Queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id/purge",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deletes all messages from the Queue."
        }
      ]
    }
  ],
  "bundled": true
}