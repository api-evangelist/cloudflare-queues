{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloudflare Queues Consumer Metrics API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Queue Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cloudflare.com/client/v4/accounts/:account_id/queues/:queue_id/metrics",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return best-effort metrics for a queue. Values may be approximate due to the distributed nature of queues."
        }
      ]
    }
  ],
  "bundled": true
}